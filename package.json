{
  "name": "agentic-loop",
  "version": "0.1.0",
  "description": "Runs an organization of AI agents from a GitHub repository on your laptop: an agent loop and a mechanical loop, shared through GitHub.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentic-loop": "./bin/agentic-loop.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
